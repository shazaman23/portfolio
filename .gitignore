# Secrets and local settings
.env
*.env
/secrets/
docker-compose.override.yml

# Editors
/.idea
.vscode
*.swp

# Terraform (every root: global, envs/qa, envs/prod)
**/.terraform/
terraform/**/*.tfstate*
terraform/**/terraform.tfvars

# Site media working copy (lives in the jakekillpack-assets-<env> buckets; see assets-tool in ~/bin)
/assets/

# Node projects (api/, web/)
node_modules/
api/dist/
api/build/
api/coverage/
web/dist/
web/coverage/
# TypeScript incremental build cache
*.tsbuildinfo

# Local files left from the Laravel app (removed in 3.0.0). Drop these lines
# once the files are deleted.
/docker-compose.yml
/composer.lock
/.phpunit.result.cache
